{
 "rotm_spec": 1,
 "name": "budget_vs_actual",
 "title": "Budget versus actual by cost centre, January to June 2026",
 "purpose": "Monthly expense actuals from the general ledger against the budget by cost centre: variance, variance % and year to date, with the same actuals by account as an independent path.",
 "output": "model.xlsx",
 "product": "both",
 "limitations": [
  "Template of the rule-of-thumb-model plugin: the ledger data are generated by make_data.py (seed 20261125); the budget is invented.",
  "Expenses are shown as positive amounts; a negative variance is spend below budget.",
  "Budget values are typed on the inputs sheet; a landed budget table would be a second raw table."
 ],
 "sheets": [
  {
   "name": "inputs",
   "type": "inputs",
   "items": [
    {"id": "start_month", "label": "First month of the model", "value": "2026-01-31", "type": "date", "unit": "date", "source": "template"},
    {"id": "scale", "label": "Display scale (fixed at 1000)", "value": 1000, "type": "number", "format": "count", "unit": "KRW per unit shown", "source": "template", "valid": {"min": 1000, "max": 1000},
     "note": "Fixed: the budget and every unit label of this template are in KRW thousand. A model in another unit needs the budget retyped and the labels changed (README)."},
    {"id": "centres", "kind": "list", "label": "Cost centres", "values": ["CC100", "CC200", "CC300", "CC400"], "format": "text", "source": "contract gl_actuals, allowed values of cost_centre"},
    {"id": "accounts", "kind": "list", "label": "Accounts", "values": ["6100", "6200", "6300", "6400"], "format": "text", "source": "contract gl_actuals, allowed values of account"},
    {"id": "budget", "kind": "grid", "label": "Budget", "unit": "KRW thousand", "format": "amount",
     "rows": {"values": ["CC100", "CC200", "CC300", "CC400"], "label": "Cost centre", "format": "text"},
     "cols": {"values": ["2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30", "2026-05-31", "2026-06-30"], "format": "month"},
     "values": [[8000, 8000, 9000, 9000, 9000, 9000],
                [5000, 5000, 5500, 5500, 6000, 6000],
                [11000, 11000, 11500, 12000, 12000, 12500],
                [3500, 3500, 3500, 3500, 3500, 3500]],
     "source": "FY2026 budget (invented for the template)"}
   ]
  },
  {"name": "raw_gl_actuals", "type": "raw", "table": "gl_actuals", "purpose": "ledger postings as landed (contract gl_actuals)"},
  {
   "name": "h_gl_actuals",
   "type": "helpers",
   "table": "gl_actuals",
   "purpose": "one row per posting: month end and amount in KRW thousand",
   "columns": [
    {"id": "month_end", "label": "Month end", "expr": "EOMONTH({this:posting_date},0)", "format": "month"},
    {"id": "amount_k", "label": "Amount (KRW thousand)", "expr": "{this:amount}/{in:scale}", "format": "amount1", "unit": "KRW thousand"}
   ]
  },
  {
   "name": "calc",
   "type": "calc",
   "purpose": "actual, budget and variance by cost centre and month; actual by account",
   "blocks": [
    {"id": "actual", "title": "Actual by cost centre", "unit": "KRW thousand", "format": "amount",
     "rows": {"in": "centres", "label": "Cost centre"},
     "cols": {"timeline": {"start": "start_month", "periods": 6, "step": "month"}},
     "cell": "SUMIFS({h:gl_actuals.amount_k},{h:gl_actuals.cost_centre},{row},{h:gl_actuals.month_end},{col})",
     "total": {"row": true, "col": true}},
    {"id": "budget_grid", "title": "Budget by cost centre", "unit": "KRW thousand", "format": "amount",
     "rows": {"same_as": "actual", "label": "Cost centre"}, "cols": {"same_as": "actual"},
     "cell": "INDEX({in:budget},MATCH({row},{in:budget.rows},0),MATCH({col},{in:budget.cols},0))",
     "total": {"row": true, "col": true}},
    {"id": "variance", "title": "Variance (actual minus budget)", "unit": "KRW thousand", "format": "amount",
     "rows": {"same_as": "actual", "label": "Cost centre"}, "cols": {"same_as": "actual"},
     "cell": "{g:actual}-{g:budget_grid}",
     "total": {"row": true, "col": true}},
    {"id": "by_account", "title": "Actual by account (independent path)", "unit": "KRW thousand", "format": "amount",
     "rows": {"in": "accounts", "label": "Account"}, "cols": {"same_as": "actual"},
     "cell": "SUMIFS({h:gl_actuals.amount_k},{h:gl_actuals.account},{row},{h:gl_actuals.month_end},{col})",
     "total": {"row": true, "col": true}}
   ]
  },
  {
   "name": "summary",
   "type": "output",
   "purpose": "year to date by cost centre: the key result",
   "blocks": [
    {"id": "ytd", "title": "Year to date by cost centre", "rows": {"same_as": "actual", "label": "Cost centre"}, "unit": "KRW thousand",
     "measures": [
      {"id": "act", "label": "Actual", "unit": "KRW thousand", "expr": "SUM({grow:actual})", "total": "sum"},
      {"id": "bud", "label": "Budget", "unit": "KRW thousand", "expr": "SUM({grow:budget_grid})", "total": "sum"},
      {"id": "var", "label": "Variance", "unit": "KRW thousand", "expr": "{m:act}-{m:bud}", "total": "sum"},
      {"id": "pct", "label": "Variance %", "unit": "%", "format": "rate", "expr": "IFERROR({m:var}/{m:bud},0)", "total": "same", "key": true}
     ]}
   ]
  },
  {
   "name": "checks",
   "type": "checks",
   "checks": [
    {"id": "actual_ties_raw", "kind": "equal", "label": "Actual block total equals the raw ledger total",
     "actual": "{blk:actual.total}", "expected": "SUM({raw:gl_actuals.amount})/{in:scale}"},
    {"id": "budget_ties_input", "kind": "equal", "label": "Budget block total equals the budget input grid",
     "actual": "{blk:budget_grid.total}", "expected": "SUM({in:budget})"},
    {"id": "variance_ties", "kind": "equal", "label": "Variance block total equals actual minus budget",
     "actual": "{blk:variance.total}", "expected": "{blk:actual.total}-{blk:budget_grid.total}"},
    {"id": "accounts_tie", "kind": "equal", "label": "Actual by account equals actual by cost centre",
     "actual": "{blk:by_account.total}", "expected": "{blk:actual.total}"},
    {"id": "ytd_pct_ties", "kind": "equal", "format": "amount", "label": "YTD variance % times budget total equals variance total (budget not 0)",
     "actual": "{cell:pct}*{blk:budget_grid.total}", "expected": "--({blk:budget_grid.total}<>0)*{blk:variance.total}",
     "note": "A budget total of 0 gives 0 % (IFERROR in Variance %) and the check then compares 0 with 0."}
   ]
  },
  {
   "name": "notes",
   "type": "notes",
   "notes": [
    {"text": "Postings include reversals (negative amounts); they count in the month they are posted.", "source": "contract gl_actuals, column amount"},
    {"text": "A cost centre or account missing from the input lists makes the raw-total checks fail: add it to the list.", "source": "checks actual_ties_raw, accounts_tie"}
   ]
  }
 ]
}
