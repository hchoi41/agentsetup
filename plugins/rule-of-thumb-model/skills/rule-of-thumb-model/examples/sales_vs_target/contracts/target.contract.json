  "connector": "power_query",
  "system": "BigQuery",
  "object": "proj.plan.sales_targets",
  "from": "proj.plan.sales_targets t",
  "where": "t.version = 'FY2026 v3' AND t.month_end BETWEEN '2026-01-31' AND '2026-06-30'"
