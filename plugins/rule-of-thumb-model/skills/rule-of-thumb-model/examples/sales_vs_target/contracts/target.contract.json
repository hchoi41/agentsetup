    "distinct": 14,
    "examples": [
     "12000000",
     "15000000",
     "13000000"
    ],
    "min": 3000000.0,
    "max": 23000000.0,
    "sum": 268000000.0
   },
   "description": "sales target for the region and month, net of VAT, in KRW"
  }
 ],
