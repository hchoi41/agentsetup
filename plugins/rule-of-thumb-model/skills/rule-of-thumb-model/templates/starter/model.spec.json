{
 "rotm_spec": 1,
 "name": "starter",
 "title": "Starter model: expenses by category and month",
 "purpose": "The smallest complete model: one raw table, one helper sheet, one grid, its checks and the master check. Copy it with rotm.py init --template starter and change it.",
 "output": "model.xlsx",
 "product": "both",
 "limitations": [
  "Starter template of the rule-of-thumb-model plugin: the data are generated by make_data.py (seed 20261125).",
  "Three months, January to March 2026."
 ],
 "sheets": [
  {
   "name": "inputs",
   "type": "inputs",
   "items": [
    {"id": "start_month", "label": "First month of the model", "value": "2026-01-31", "type": "date", "unit": "date", "source": "template"},
    {"id": "categories", "kind": "list", "label": "Categories", "values": ["Rent", "Staff", "Supplies", "Travel"], "format": "text", "source": "contract lines, allowed values of category"}
   ]
  },
  {"name": "raw_lines", "type": "raw", "table": "lines", "purpose": "expense lines as landed (contract lines)"},
  {
   "name": "h_lines",
   "type": "helpers",
   "table": "lines",
   "purpose": "one row per expense line: its month end",
   "columns": [
    {"id": "month_end", "label": "Month end", "expr": "EOMONTH({this:line_date},0)", "format": "month"}
   ]
  },
  {
   "name": "calc",
   "type": "calc",
   "font_size": 9,
   "purpose": "expenses by category and month",
   "blocks": [
    {"id": "spend", "title": "Expenses by category and month", "unit": "KRW", "format": "amount",
     "rows": {"in": "categories", "label": "Category"},
     "cols": {"timeline": {"start": "start_month", "periods": 3, "step": "month"}},
     "cell": "SUMIFS({h:lines.amount},{h:lines.category},{row},{h:lines.month_end},{col})",
     "total": {"row": true, "col": true}}
   ]
  },
  {
   "name": "checks",
   "type": "checks",
   "checks": [
    {"id": "spend_ties_raw", "kind": "equal", "label": "Grid total equals the raw total of amount",
     "actual": "{blk:spend.total}", "expected": "SUM({raw:lines.amount})"}
   ]
  }
 ]
}
