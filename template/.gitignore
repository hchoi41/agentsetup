# =============================================================================
# Project .gitignore — tracks only writable role folders
# =============================================================================

# Read-only roles (do not track)
00.ABOUT/
01.PROJECT/*/10.INPUT/
10.OPERATION/*/10.INPUT/
02.INPUT_TEMPLATES/
01.PROJECT/*/30.OUTPUT/
10.OPERATION/*/30.OUTPUT/

# System and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# OneDrive conflict files
~$*

# OS metadata
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# IDE / editor state
.vscode/
.idea/
*.code-workspace
