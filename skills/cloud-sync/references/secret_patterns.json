{
  "version": 1,
  "patterns": [
    {"name": "aws_access_key_id", "regex": "AKIA[0-9A-Z]{16}"},
    {"name": "aws_secret_access_key", "regex": "(?i)aws_secret_access_key\\s*[:=]\\s*[A-Za-z0-9/+]{40}"},
    {"name": "private_key_block", "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"},
    {"name": "generic_api_key", "regex": "(?i)(api[_-]?key|secret|token|passwd|password)\\s*[:=]\\s*[\"']?[A-Za-z0-9_\\-]{16,}"},
    {"name": "bearer_token", "regex": "(?i)bearer\\s+[A-Za-z0-9._\\-]{20,}"},
    {"name": "slack_token", "regex": "xox[baprs]-[0-9A-Za-z\\-]{10,}"},
    {"name": "github_pat", "regex": "gh[pousr]_[A-Za-z0-9]{36,}"}
  ]
}
