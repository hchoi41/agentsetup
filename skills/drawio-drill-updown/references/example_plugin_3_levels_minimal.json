     "y": 241,
     "w": 300,
     "h": 73
    },
    {
     "id": "skills2",
     "role": "propose",
     "text": "Narrate the run\n\u2022 the step log\n\u2022 the classified differences\n\u00a0\u00a0\u00a0\u00a0\u00a0\u25e6 never adjudicate them",
