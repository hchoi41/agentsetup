     "y": 346,
     "w": 300,
     "h": 85
    },
    {
     "id": "scripts2",
     "role": "decide",
     "text": "Run and compare\n\u2022 one capped job per step\n\u2022 CSV plus typed sidecar\n\u2022 compare B with its steps\n\u2022 then A with B's steps\n\u2022 classify the differences",
