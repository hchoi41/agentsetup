     "y": 346,
     "w": 300,
     "h": 85
    },
    {
     "id": "scripts3",
     "role": "decide",
     "text": "Test and close\n\u2022 sample the local CSVs\n\u2022 trace by key\n\u2022 chain, MECE, reference tie-out\n\u2022 exit non-zero on mismatch\n\u2022 close by manifest",
